{
  "name": "cloud-doc",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Collaborative wiki on Cloudflare Workers, Durable Objects and D1, with files and history in each user's WebDAV storage.",
  "scripts": {
    "predev": "node scripts/ensure-storage-key.mjs --local",
    "dev": "wrangler dev",
    "build": "vite build",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test:api": "node test/api.mjs",
    "test:ui": "node test/ui.cjs",
    "predeploy": "node scripts/ensure-storage-key.mjs --remote",
    "postdeploy": "node scripts/ensure-storage-key.mjs --remote --strict",
    "check:browsers": "node scripts/check-browsers.mjs"
  },
  "dependencies": {
    "@blocknote/core": "^0.57.0",
    "@blocknote/mantine": "^0.57.0",
    "@blocknote/react": "^0.57.0",
    "@mantine/core": "^9.8.1",
    "@mantine/hooks": "^9.8.1",
    "@tabler/icons-react": "^3.52.0",
    "katex": "^0.19.1",
    "partyserver": "^0.5.10",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "y-partyserver": "^2.2.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "^1.65.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "wrangler": "^4.165.0",
    "ws": "^8.23.0"
  }
}
