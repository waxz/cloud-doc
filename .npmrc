# y-partyserver 2.2.0 declares @cloudflare/workers-types ^4 as a peer, while
# Wrangler wants ^5; no version satisfies both, so a strict install fails.
# The package only holds TypeScript types (nothing at runtime), and every
# peer this project needs is listed in package.json. Remove this once
# y-partyserver accepts workers-types 5.
legacy-peer-deps=true
